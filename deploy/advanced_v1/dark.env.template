# Governed Advanced-v1 DARK deployment ENV TEMPLATE (NO SECRETS — placeholders only).
# WO-HELM-HERMES-DEPLOYED-PROVENANCE-SCOPE-READINESS-AND-REPRODUCIBLE-DARK-CONFIG-0001.
# Copy to a governed, access-controlled env file (NEVER commit the filled version); fill environment-specific values.
# Precedence (lowest -> highest): container defaults < base compose < THIS env file < dark overlay explicit values.
# The dark overlay sets HERMES_ADVANCED_V1_MASTER_ENABLED/PUBLISHER_MODE explicitly, so an unsafe env value here
# CANNOT override the governed dark state (see dark_config_preflight.py).

# --- immutable runtime identity (pin the digest from the governed build evidence) ---
HERMES_IMAGE_REF=hermes-signal:prod-<12hexsha>
HERMES_IMAGE_TAG=prod-<12hexsha>
HERMES_REQUIRE_DIGEST_PIN=true

# --- expansion dark controls (authoritative also in the overlay; kept here for auditable single-source) ---
HERMES_ADVANCED_V1_MASTER_ENABLED=false
HERMES_ADVANCED_V1_PUBLISHER_MODE=DISABLED

# --- existing authorised XAU pilot family controls ---
HERMES_TICK_PUBLISH_ENABLED=true
HERMES_TICK_PUBLISH_AUTHORISED=true
HERMES_INDICATOR_PUBLISH_ENABLED=true
HERMES_INDICATOR_PUBLISH_AUTHORISED=true
HERMES_GAPS_PUBLISH_ENABLED=true
HERMES_GAPS_PUBLISH_AUTHORISED=true
HERMES_BACKFILL_STATUS_PUBLISH_ENABLED=true
HERMES_BACKFILL_STATUS_PUBLISH_AUTHORISED=true
HERMES_FEED_HEALTH_PUBLISH_ENABLED=true
HERMES_FEED_HEALTH_PUBLISH_AUTHORISED=true

# --- hard safety invariants ---
CONSUMER_LIVE=false
HERMES_BACKFILL_EXECUTION_ENABLED=false

# --- environment-specific connectivity (FILL with governed values; NEVER commit real secrets) ---
DEV_DB_HOST=<db-host>
DEV_DB_PORT=<db-port>
DB_USER=<db-user>
DB_PASSWORD=<SECRET — supply via governed secret mechanism, not in Git>
DB_NAME=<db-name>
