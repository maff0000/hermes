# Governed HERMES COMPLETE deployment ENV TEMPLATE (NO SECRETS — placeholders only).
# WO-HELM-HERMES-COMPLETE-TRACKED-RUNTIME-CONFIG-AND-XAU-PARITY-0001.
# Copy to a governed, access-controlled env file (chmod 600; NEVER commit the filled version).
# Canonical, environment-neutral names. The operational overlay maps DB_*/REDIS_* onto the app's DEV_*
# names. Secrets (DB_PASSWORD, OANDA_API_KEY/ACCOUNT_ID, REDIS_PASSWORD) come from the base .env env_file;
# only the authority-bearing activation token must be supplied here (or via the governed secret store).
# Precedence: container defaults < base compose < THIS env file (interpolation) < operational overlay <
# dark overlay explicit values. A copied-but-incomplete file FAILS runtime_config_preflight_v1.

# ---- rollback (previous immutable digest; required by preflight) ----
HERMES_ROLLBACK_IMAGE_REF=hermes-signal@sha256:<previous-digest>

# ===== identity =====
# [REQUIRED, iso8601] build identity invalid
BUILD_UTC=<fill>
# [REQUIRED, string] mutable/unpinned image; non-reproducible runtime
HERMES_IMAGE_REF=<fill>
# [required-in-overlay, string] image tag unresolved
HERMES_IMAGE_TAG=<fill>
# [optional, bool] mutable-tag deploy permitted
HERMES_REQUIRE_DIGEST_PIN=true
# [REQUIRED, sha40] UNKNOWN provenance; unpromotable candidate
SOURCE_SHA=<fill>

# ===== db =====
# [REQUIRED, string, host-specific, parity-critical] DB unreachable -> boot-gate fail
DB_HOST=<192.168.11.10>
# [REQUIRED, string, parity-critical] wrong schema / boot-gate fail
DB_NAME=<tradingSignals>
# [required-in-overlay, string, SECRET->from .env, do NOT put here] auth fail
# DB_PASSWORD=<SECRET — supplied by base .env, not here>
# [REQUIRED, int, host-specific, parity-critical] silent 3306 default -> DB unreachable -> restart loop
DB_PORT=<3307>
# [required-in-overlay, string] auth fail
DB_USER=<fill>

# ===== redis =====
# [optional, int, parity-critical] wrong Redis DB -> split-brain
REDIS_DB=0
# [REQUIRED, string, host-specific, parity-critical] publication/routing to wrong Redis
REDIS_HOST=<192.168.11.10>
# [optional, string, parity-critical] key namespace drift
REDIS_KEY_PREFIX=hermes:
# [required-in-overlay, string, SECRET->from .env, do NOT put here] auth fail if required
# REDIS_PASSWORD=<SECRET — supplied by base .env, not here>
# [optional, int, host-specific, parity-critical] wrong Redis port
REDIS_PORT=6379

# ===== canonical_redis =====
# [REQUIRED, string, AUTHORITY->governed secret, parity-critical] canonical activation refused -> candle canonical publish disabled
HERMES_CANDLE_CANONICAL_ACTIVATION_APPROVAL=<GOVERNED-AUTHORITY-TOKEN — external secret, never in Git>
# [optional, csv, parity-critical] canonical scope change
