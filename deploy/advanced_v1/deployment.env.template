# [REQUIRED, string, host-specific, parity-critical] canonical candle publish misrouted/broken
HERMES_CANDLE_CANONICAL_REDIS_HOST=<192.168.11.10>
# [optional, int, host-specific, parity-critical] canonical publish wrong port
HERMES_CANDLE_CANONICAL_REDIS_PORT=6379

