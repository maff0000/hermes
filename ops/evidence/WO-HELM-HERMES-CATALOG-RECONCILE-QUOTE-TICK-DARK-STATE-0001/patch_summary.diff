+    p = _build()
+    assert p["quote_contract"]["status"] != ic.SURFACE_ACTIVE and p["tick_contract"]["status"] != ic.SURFACE_ACTIVE
+    assert p["status"] == ic.STATUS_GREEN                       # core surfaces still GREEN; dark quote/tick don't degrade
