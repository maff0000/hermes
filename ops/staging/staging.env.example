# =============================================================================
# HERMES — STAGING CONTAINER PROFILE (.env example)
# =============================================================================
# THREAD-ALPHA — Staged Container Isolation.
#
# This file is the STAGING container deployment profile consumed by
# docker-compose.yml (the on-main, environment-blind, network-isolated stack:
# WO-HELM-HERMES-ENVIRONMENT-BLIND-ISOLATION-0003).
#
# HOW TO USE:
#   cp ops/staging/staging.env.example .env     # at deploy time, on the staging box
#   <fill in the placeholder secrets>           # NEVER commit the populated .env
#
# SECRETS: every CHANGE_ME_* value below is a PLACEHOLDER, supplied at deploy
# time on the staging host. NO REAL SECRET is ever committed to the repo. The
# image is environment-blind: it carries no host coupling and no baked secrets.
#
# SAFETY: this profile is for the STAGING/DEV box only. It introduces an
# explicit RUN_ENV=STAGING so the out-of-band purge engine (ops/purge.py) treats
# this box as non-production and BYPASSES (deletes nothing). Production is
# untouched by this file.
# =============================================================================


# -----------------------------------------------------------------------------
# RUN ENVIRONMENT — explicit, prominent, and non-production.
# -----------------------------------------------------------------------------
# RUN_ENV gates the out-of-band purge engine (ops/purge.py). Only
# RUN_ENV=PRODUCTION can ever delete; STAGING => clean BYPASS (ledger preserved).
# This is DELIBERATELY separate from ENVIRONMENT (which drives DB host
# resolution in env_config: DB_HOST -> {ENVIRONMENT}_DB_HOST, ENVIRONMENT in
# DEV/PROD). Staging keeps ENVIRONMENT=DEV for host-resolution semantics while
# carrying its own RUN_ENV=STAGING gate identity.
RUN_ENV=STAGING
ENVIRONMENT=DEV


# -----------------------------------------------------------------------------
# SIGNAL SERVICE — HTTP port binding.
# -----------------------------------------------------------------------------
# SIGNAL_PORT       : the in-container port FastAPI binds (and the healthcheck probes).
# SIGNAL_BIND_PORT  : the published HOST port (host:container in compose).
#
# CUTOVER NOTE: during the parallel/shadow phase of the staging handoff, set
# SIGNAL_BIND_PORT=8211 so the container runs ALONGSIDE the legacy systemd unit
# (which owns host :8210) without a port clash. Flip back to 8210 only AFTER the
# systemd unit is `systemctl disable --now`'d. See
# ops/runbooks/STAGING_CONTAINER_DEPLOY.md.
SIGNAL_PORT=8210
SIGNAL_BIND_PORT=8211


# -----------------------------------------------------------------------------
# IMAGE TAG — built from the on-main two-stage Dockerfile (target: runtime).
# -----------------------------------------------------------------------------
HERMES_IMAGE_TAG=staging


# -----------------------------------------------------------------------------
# RESOURCE PINS — emulate a 4 vCore / 4 GB IONOS M+ VPS.
# -----------------------------------------------------------------------------
# These MUST equal the effective cgroup caps the container runs under. Verified
# by ops/staging/resource_cap_verify.py (reason code GOV-STAGE-CAP-001 on drift).
HERMES_CPUS=4
HERMES_MEM_LIMIT=4g
HERMES_MEM_RESERVATION=1g
HERMES_PIDS_LIMIT=512


# -----------------------------------------------------------------------------
# BUNDLED INTERNAL MariaDB (hermes-mariadb) — INTERNAL BRIDGE ONLY.
# -----------------------------------------------------------------------------
# The bundled DB is published to NO host interface; it is reachable solely via
# the private bridge DNS name `hermes-mariadb:3306`. The signal container
# overrides DB_HOST=hermes-mariadb / DB_PORT=3306 in compose, so any host-DB
# value here is for completeness only and is NOT used to reach the bundled DB.
DB_NAME=tradingSignals
DB_USER=hermes
DB_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD          # placeholder — supply at deploy
DB_ROOT_PASSWORD=CHANGE_ME_STAGING_DB_ROOT_PASSWORD # placeholder — supply at deploy


# -----------------------------------------------------------------------------
# GELF / SIEM LOG SHIPPING — out-of-band to Graylog (UDP 12201).
# -----------------------------------------------------------------------------
# Prefer SIEM_GRAYLOG_IP (new canonical). GRAYLOG_HOST is the legacy fallback.
# If neither is set, compose falls back to 127.0.0.1 (logs stay on the box).
# Point these at the staging Graylog collector.
SIEM_GRAYLOG_IP=CHANGE_ME_STAGING_GRAYLOG_IP        # placeholder — staging SIEM collector
SIEM_GRAYLOG_PORT=12201
GRAYLOG_HOST=CHANGE_ME_STAGING_GRAYLOG_IP           # legacy fallback (keep in sync with SIEM_GRAYLOG_IP)


# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# * The signal container reaches the bundled DB by service DNS only; the DB has
#   no host port (zero-leak). Do NOT add a `ports:` mapping to hermes-mariadb.
# * `restart: unless-stopped` (set in compose) gives reboot-safety once cutover
#   is complete and the systemd unit is disabled.
# * Validate before bringing anything up:  docker compose --env-file .env config
