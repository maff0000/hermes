# HMT-2 ops configuration -- EXAMPLE FILE, values below are illustrative placeholders, not any
# real host's actual configuration. Install as /etc/hmt2/hmt2-ops.env (root:root, mode 0640;
# world-unreadable is not required since it contains no secret VALUES, only a secret PATH, but
# 0640 keeps it consistent with the rest of this host's ops file conventions) and fill in real,
# host-specific values. Every value here corresponds 1:1 to an environment variable documented
# in market_truth/acquisition/orchestration/config.py -- read that file's ENV_* constants for
# the authoritative name/meaning/default of each.
#
# This file is sourced by:
#   - deployment/hmt2/hmt2-run.sh / hmt2-acquire-run.sh / hmt2-disk-guard.sh (shell `source`)
#   - deployment/hmt2/render_unit_template.sh (to render the systemd unit templates)
#   - market_truth.acquisition.orchestration.config.Hmt2OpsConfig.from_env(), if these same
#     names are also exported into the orchestrator's own process environment (e.g. via a
#     systemd `EnvironmentFile=` directive on whatever wraps the orchestrator's own invocation --
#     the orchestrator itself must still be launched directly as root, never through
#     hmt2-run.sh; see canonical_root_orchestrator.py's module docstring).

# --- Paths -------------------------------------------------------------------------------------
HMT2_OPS_REPO_DIR=/srv/hmt-code/hermes
HMT2_OPS_VENV_PYTHON=/srv/hmt-code/hmt2-venv/bin/python3
HMT2_OPS_LAUNCHER_PATH=/usr/local/sbin/hmt2-run.sh
HMT2_OPS_ACQUIRE_LAUNCHER_PATH=/usr/local/sbin/hmt2-acquire-run.sh
HMT2_CANONICAL_RESEARCH_ROOT=/srv/hmt-data/canonical
HMT2_OPS_SCRATCH_DIR=/srv/hmt-data/scratch
HMT2_OPS_EVIDENCE_ROOT=/srv/hmt-data/evidence
HMT2_OPS_ORACLE_PATH=/srv/hmt-data/evidence/oracle/pre-loss-regression-oracle-150.json
HMT2_OPS_ACQUIRE_SECRET_PATH=/srv/hmt-secrets/databento_historical_api_key

# --- Launcher-script-only aliases (same values, referenced by shell scripts directly) ----------
HMT2_SCRATCH_DIR=/srv/hmt-data/scratch
HMT2_ACQUIRE_SECRET_PATH=/srv/hmt-secrets/databento_historical_api_key

# --- Identities (uid/gid VALUES are host-local -- never assume portable) -----------------------
HMT2_SLICE_NAME=hmt2.slice
HMT2_COMPUTE_UID=hmt-compute
HMT2_COMPUTE_GID=hmt
HMT2_DATA_UID=hmt-data
HMT2_DATA_GID=hmt
HMT2_ACQUIRE_SECRETS_GID=hmt-acquire-secrets

# --- Disk guard ----------------------------------------------------------------------------------
HMT2_OPS_DISK_GUARD_MOUNT=/srv
HMT2_OPS_DISK_GUARD_WARN_PCT=70
HMT2_OPS_DISK_GUARD_STOP_PCT=80
HMT2_DISK_GUARD_MOUNT=/srv
HMT2_DISK_GUARD_WARN_PCT=70
HMT2_DISK_GUARD_STOP_PCT=80
HMT2_DISK_GUARD_INTERVAL_MIN=15
HMT2_DISK_GUARD_SCRIPT_PATH=/usr/local/sbin/hmt2-disk-guard.sh

# --- Per-session / host-guard policy (scale MemAvailable floors to this host's real RAM) -------
HMT2_OPS_PER_SESSION_TIMEOUT_SEC=900
HMT2_OPS_PRE_SESSION_MIN_MEMAVAILABLE_KB=41943040
HMT2_OPS_IN_SESSION_MIN_MEMAVAILABLE_KB=25165824
HMT2_OPS_SUSTAINED_LOW_MEM_SECONDS=60
HMT2_OPS_POLL_INTERVAL_SEC=5
HMT2_OPS_PSI_FULL_AVG10_STALL_THRESHOLD=5.0

# --- Routine resource envelope (hmt2.slice) -- also used to render hmt2.slice from its template
HMT2_OPS_ROUTINE_MEMORY_HIGH_BYTES=12884901888
HMT2_OPS_ROUTINE_MEMORY_MAX_BYTES=17179869184
HMT2_SLICE_MEMORY_HIGH=12G
HMT2_SLICE_MEMORY_MAX=16G
HMT2_SLICE_CPU_QUOTA=800%
HMT2_SLICE_IO_WEIGHT=50

# --- Exceptional envelope policy -- the ceiling is an Architect-owned value, never raised by
# code on its own initiative; see market_truth/acquisition/orchestration/exceptional_envelope.py
HMT2_OPS_EXCEPTIONAL_PREFLIGHT_MIN_MEMAVAILABLE_KB=41943040
HMT2_OPS_EXCEPTIONAL_AUTHORISED_CEILING_MEMORY_MAX_BYTES=25769803776

# --- Bounded chunking doctrine ------------------------------------------------------------------
HMT2_OPS_MAX_CANONICAL_CHUNK_SESSIONS=10
