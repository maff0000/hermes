# HERMES canonical runtime configuration — SHARED schema (one schema, one file per environment).
# WO-HELM-HERMES-DEV-PROD-SINGLE-CONFIG-CONTRACT-CONVERGENCE-0001.
# Same codebase runs DEV and PROD; ONLY VALUES differ, never the schema. No env encoded in source/image/systemd.
# Behavioural config here; SECRET VALUES live in separately-permissioned secret files (referenced, not inlined).
# Config is resolved via env_config.get_env -> {ENVIRONMENT}_{KEY} with non-prefixed fallback. NO real secrets in Git.

# --- environment identity ---
ENVIRONMENT=PROD                      # DEV | PROD  (never STAGING-as-DEV; PROD must not inherit DEV-only enablement)

# --- OANDA (shared credential model; DEV+PROD coordinate as polite clients) ---
OANDA_ENVIRONMENT=live                # live | practice
# OANDA_ACCOUNT_ID / OANDA token -> secret file (referenced, not here)
OANDA_SCHEDULE_PHASE_OFFSET_SECONDS=0 # DEV=0 ; PROD=20  (offsets REST *initiation* only; never market timestamps)
OANDA_REST_MAX_RPS=10                 # local governor, well below OANDA 120/s/IP

# --- DB (cloud-local per environment) ---   values via {ENV}_DB_* ; password via secret file
# {ENV}_DB_HOST  {ENV}_DB_PORT  {ENV}_DB_USER  DB_NAME  {ENV}_DB_PASSWORD(secret)

# --- Redis (cloud-local per environment) --- values via {ENV}_REDIS_* ; password via secret file (may be empty on private net)
# {ENV}_REDIS_HOST  {ENV}_REDIS_PORT  {ENV}_REDIS_DB  {ENV}_REDIS_KEY_PREFIX  {ENV}_REDIS_PASSWORD(secret)
# HERMES_CANDLE_CANONICAL_REDIS_HOST/PORT/DB -> the environment's OWN cache (never cross-environment)

# --- shadow tick emitter (DEV-only diagnostic capability; MUST be governed by config) ---
HERMES_SHADOW_TICK_PUBLISH_ENABLED=false   # DEV may set true; PROD=false. DISABLED => fully INERT (no client, no socket, no I/O).
HERMES_SHADOW_TICK_AUTHORISED=false        # required true only when enabled
# HERMES_SHADOW_TICK_REDIS_HOST/PORT/DB    # REQUIRED only when enabled (no hidden 6380 default). §20: enabled+down => bounded (0.5s timeout) + circuit breaker.
HERMES_CANDLE_FORWARD_SHADOW_AUTHORISED=false
HERMES_CANDLE_FORWARD_SHADOW_DEV_SHADOW=false

# --- publication (XAU pilot active; expansion dark) ---
HERMES_ADVANCED_V1_MASTER_ENABLED=false
HERMES_ADVANCED_V1_PUBLISHER_MODE=DISABLED
HERMES_CANDLE_PUBLISH_ENABLED=true
HERMES_INDICATOR_PUBLISH_ENABLED=true
HERMES_CANDLE_CANONICAL_INSTRUMENTS=XAU_USD

# --- health / runtime ---
# {ENV}_SIGNAL_PORT (health/readiness bind)   {ENV}_DEBUG   {ENV}_ARCHIVE_DIR
# resource caps: HERMES_CPUS / HERMES_MEM_LIMIT / HERMES_PIDS_LIMIT must match the deployment cgroup (boot-gate GOV-STAGE-CAP)
