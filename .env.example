# ============================================
# Trading Signals Service - ENVIRONMENT CONFIG
# EPIC-D002: Standalone Signal Service
# ============================================
# DEV:  /srv-dev/tradingSignals
# PROD: /srv/tradingSignals
# Port: 8210
# ============================================

# ============================================
# OANDA API Configuration
# ============================================
OANDA_API_KEY=your-oanda-api-key
OANDA_ACCOUNT_ID=your-account-id
OANDA_ENVIRONMENT=practice

# ============================================
# IBKR Configuration (backup source)
# ============================================
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ============================================
# Database Configuration (standardized per governance)
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=tradingSignals
# Root password for the BUNDLED hermes-mariadb container (docker-compose.yml, WO-...-ISOLATION-0003).
# Internal-bridge-only DB — no host port. Provide a real value at deploy; NEVER commit a real secret.
DB_ROOT_PASSWORD=your-db-root-password

# ============================================
# Redis Configuration
# DEV:  noustai-redis:6379, DB 1, prefix dev:
# PROD: TAS_redis:6380, DB 0, prefix prod:
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=prod:

# ============================================
# Signal Service Settings
# ============================================
SIGNAL_HOST=0.0.0.0
SIGNAL_PORT=8210
DEBUG=false

# Write ticks to DB (high volume - optional)
WRITE_TICKS=false

# ============================================
# Archive Settings
# ============================================
ARCHIVE_DIR=/data/signal_history
ARCHIVE_MONTHS_TO_KEEP=12

# ============================================
# Instruments (loaded from DB, fallback list)
# ============================================
INSTRUMENTS=XAU_USD,XAG_USD,XPT_USD,XCU_USD

# ============================================
# Out-of-band SIEM / Graylog GELF target
# ============================================
# WO-HELM-HERMES-ENVIRONMENT-BLIND-ISOLATION-0003 — canonical SIEM endpoint. The app ships syslog
# severities {2,3,4,6,7} (CRITICAL/ERROR/WARNING/INFO/DEBUG) out-of-band via GELF to SIEM_GRAYLOG_IP:12201.
# SIEM_GRAYLOG_IP is preferred; GRAYLOG_HOST is the legacy fallback (kept so existing deploys still boot).
# Fail-loud (GOV-LOG-012) if NEITHER is set. LOG_LEVEL governs the emitted floor (DEBUG to include level 7).
SIEM_GRAYLOG_IP=
SIEM_GRAYLOG_PORT=12201
# WO-HELM-HERMES-LOGGING-VENDOR-0001 — legacy GELF/Graylog target (fallback only)
GRAYLOG_HOST=
GRAYLOG_PORT=12201
# LOG_LEVEL=INFO   # DEBUG to ship syslog level 7 as well

# ============================================
# Environment-blind container deployment (WO-...-ISOLATION-0003; consumed by docker-compose.yml)
# Image carries NO secrets; bundled hermes-mariadb is internal-bridge-only (no host port).
# ============================================
HERMES_IMAGE_TAG=local
# Host port the signal service is published on (container port stays SIGNAL_PORT)
SIGNAL_BIND_PORT=8210
# --- Resource pinning: emulate a 4 vCore / 4 GB IONOS M+ VPS ---
HERMES_CPUS=4
HERMES_MEM_LIMIT=4g
HERMES_MEM_RESERVATION=1g
HERMES_PIDS_LIMIT=512

# Candle-forward runtime seam — DISABLED by default; see ops/config/candle_forward_runtime_seam.md
# WO-...-WIRE-INERT-0001 (inert) + WO-...-SHADOW-WRITER-WIRE-DEV-0001 (dev shadow writer).
HERMES_CANDLE_FORWARD_ENABLED=false
# HERMES_CANDLE_FORWARD_SINK=inert   # required ONLY if enabled. Modes: none|inert (no-write) | shadow (dev)
#                                    # canonical|live|prod -> FAIL LOUD (separate gated WO)
# Shadow mode (HERMES_CANDLE_FORWARD_SINK=shadow) — dev Redis 6380 only; writes ONLY M5/H1
# hermes:shadow:candles:*; NOT enabled here. All required, no defaults:
# HERMES_CANDLE_FORWARD_SHADOW_REDIS_HOST=192.168.11.10
# HERMES_CANDLE_FORWARD_SHADOW_REDIS_PORT=6380
# HERMES_CANDLE_FORWARD_SHADOW_REDIS_DB=0
# HERMES_CANDLE_FORWARD_SHADOW_AUTHORISED=false        # must be true to activate shadow
# HERMES_CANDLE_FORWARD_SHADOW_TREAT_AS_PRODUCTION=false
# HERMES_CANDLE_FORWARD_SHADOW_DEV_SHADOW=true          # required when target is loopback

# ============================================
# Out-of-band DB purge engine (HERMES-OPS-PURGE-001) — standalone `python3 ops/purge.py`
# NEVER imported by main.py / hot-path. DEV/STAGING are never purged (local ledger preserved).
# Two independent gates must BOTH be satisfied before a single row is deleted:
#   1) RUN_ENV=PRODUCTION   (anything else -> clean [PURGE_BYPASS] exit 0)
#   2) HERMES_PURGE_ENABLED=TRUE  (PRODUCTION without this -> fail-loud GOV-PURGE-001, exit 1)
# NOTE: RUN_ENV is distinct from ENVIRONMENT (used for DB resolution). Production MUST set RUN_ENV
#       explicitly or the engine bypasses. Deletes outside PLUTUS require explicit owner authorisation.
# ============================================
RUN_ENV=DEVELOPMENT
HERMES_PURGE_ENABLED=FALSE
# Required when enabled (NO defaults — unconfigured engine deletes nothing):
# PURGE_RETENTION_DAYS=30
# PURGE_TABLES=ticks:received_at,candles_M5:timestamp,candles_H1:timestamp   # table:timestamp_column list
#   HARDCODED ALLOWLIST — only {ticks, candles_M1, candles_M5, candles_M15, candles_H1, candles_D1}
#   accepted; anything else -> GOV-PURGE-004.
# Optional tuning (safe defaults shown):
# PURGE_BATCH_SIZE=5000           # rows per chunk (LIMIT)
# PURGE_BATCH_SLEEP_MS=200        # micro-sleep between chunks; FLOOR=1 (0 -> fail-loud) to force a yield
# PURGE_MAX_BATCHES_PER_TABLE=100000   # runaway backstop per table (0 = unlimited)
# Telemetry (PURGE_CYCLE_START / PURGE_BATCH / PURGE_CYCLE_COMPLETE) ships via GELF to SIEM_GRAYLOG_IP.

# ============================================
# Automated outage backfill recovery (WO-HERMES-AUTOMATED-BACKFILL-RECOVERY)
# Runs at container boot AFTER the cgroup boot gate, BEFORE the live runtime (docker/entrypoint.sh ->
# tools/backfill_recovery_engine.py). DISABLED by default (no-op clean). When enabled it computes the
# gap from the destination MAX(timestamp), backfills ONLY the missing interval (idempotent), and HALTS
# with a critical flag if the gap exceeds the bounded window.
# ============================================
# PURGE-GRADE ACTIVATION MATRIX (Invariant B) — ALL THREE required to arm; a config change to the
# enable flag ALONE can never flip it on (Invariant C). Inert dead-code on `main` until then.
#   1) RUN_ENV=PRODUCTION  (exact)
#   2) HERMES_BACKFILL_RECOVERY_ENABLED=TRUE  (STRICT, case-sensitive — anything else = inert no-op)
#   3) HERMES_ARCHITECT_RECOVERY_SIGNATURE present (non-empty architect authorisation token)
# Armed-but-incomplete (enable=TRUE without PRODUCTION or signature) -> hard abort GOV-STAGE-CAP-003
# (Missing Parameters) before any delta is computed.
HERMES_BACKFILL_RECOVERY_ENABLED=FALSE
HERMES_ARCHITECT_RECOVERY_SIGNATURE=
# HERMES_BACKFILL_MAX_WINDOW_HOURS=24   # gap beyond this -> AMBER_STOP RC=20 -> entrypoint TERMINAL HALT RC=102
# Out-of-band, fail-silent recovery alert to #the-rogue-alliance. Missing/invalid -> alert muted, NEVER
# blocks or alters recovery. Provide the real webhook at deploy; NEVER commit a real webhook URL.
ROGUE_ALLIANCE_DISCORD_WEBHOOK=
