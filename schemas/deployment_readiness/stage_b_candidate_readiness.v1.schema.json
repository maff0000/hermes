{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hermes/schemas/deployment_readiness/stage_b_candidate_readiness.v1.schema.json",
  "title": "HERMES FW-08 Stage-B candidate-readiness evidence v1",
  "description": "Machine-readable candidate-readiness evidence emitted by tools/hermes_stage_b_build_v1.py. Candidate readiness is NOT publication, NOT deployment, NOT activation. The mechanical safety flags MUST all be false for a ready candidate. No secrets. WO-HELM-HERMES-FW08-GOVERNED-STAGE-B-IMAGE-BUILD-ENFORCEMENT-IMPLEMENTATION-0001.",
  "type": "object",
  "required": [
    "contract_version",
    "tool_version",
    "application",
    "source_sha",
    "build_utc",
    "candidate_name",
    "ready",
    "state",
    "reason_codes",
    "transitions",
    "runtime_wired",
    "config_installed",
    "shadow_enabled",
    "shadow_executed",
    "consumer_live",
    "phase2_activated",
    "published",
    "deployed"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "1"},
    "tool_version": {"type": "string", "const": "1"},
    "application": {"type": "string", "const": "hermes"},
    "source_sha": {"type": "string"},
    "build_utc": {"type": "string"},
    "candidate_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "ready": {"type": "boolean"},
    "state": {
      "type": "string",
      "enum": [
        "NOT_STARTED", "SOURCE_VERIFIED", "CONTEXT_EXPORTED", "CONTEXT_VERIFIED",
        "BUILD_READY", "BUILD_COMPLETED", "IMAGE_INSPECTED", "SBOM_COMPLETED",
        "VULNERABILITY_SCAN_COMPLETED", "CANDIDATE_READY", "REJECTED"
      ]
    },
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "image_id": {"type": ["string", "null"]},
    "provenance": {"type": ["object", "null"]},
    "effective_context": {"type": ["object", "null"]},
    "oci_postbuild": {"type": ["object", "null"]},
    "image_content": {"type": ["object", "null"]},
    "sbom": {"type": ["object", "null"]},
    "vuln_scan": {"type": ["object", "null"]},
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_state", "to_state", "at_utc", "reason_code", "source_sha"],
        "properties": {
          "from_state": {"type": "string"},
          "to_state": {"type": "string"},
          "at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(\\+00:00|Z)$"},
          "reason_code": {"type": "string"},
          "source_sha": {"type": "string"},
          "image_id": {"type": ["string", "null"]},
          "evidence_ref": {"type": ["string", "null"]}
        }
      }
    },
    "runtime_wired": {"type": "boolean", "const": false},
    "config_installed": {"type": "boolean", "const": false},
    "shadow_enabled": {"type": "boolean", "const": false},
    "shadow_executed": {"type": "boolean", "const": false},
    "consumer_live": {"type": "boolean", "const": false},
    "phase2_activated": {"type": "boolean", "const": false},
    "published": {"type": "boolean", "const": false},
    "deployed": {"type": "boolean", "const": false}
  }
}
