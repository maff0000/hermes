# HERMES signal-truth canary — external configuration TEMPLATE (NO SECRETS — placeholders only).
# WO-HELM-HERMES-BUILD-CONTEXT-SECRET-LEAK-CONTAINMENT-AND-CLEAN-SOURCE-BUILD-HARDENING-0001.
#
# The canary loads its config STRICTLY from the process environment (hermes_signal_truth_canary.load_config).
# It NEVER reads a plaintext `.env` beside the script, and NEVER falls back to a shared/estate credential.
# To run the canary, export these variables from a GOVERNED external secret location (outside any source/build
# directory), or copy this template to a governed env file and `set -a; . file; set +a` before invocation.
# HERMES-specific canonical names (HERMES_CANARY_*) are preferred; legacy CANARY_* is still accepted.
#
# CREDENTIAL POLICY: the canary MUST use a DEDICATED, least-privilege read-only DB identity scoped to `tradingSignals`
# only — NOT the shared estate-wide `trinity` account (SELECT on tradingRisk/tradingSignals/tradingProteus). The
# dedicated account is provisioned by a separately governed credential-migration WO (see deploy docs).

HERMES_CANARY_ENABLED=true
HERMES_CANARY_INSTRUMENT=<instrument, e.g. XAU_USD>
HERMES_CANARY_CHECK_INTERVAL_SECONDS=60
HERMES_CANARY_M1_STALE_THRESHOLD_SECONDS=180
HERMES_CANARY_SIGNAL_TRUTH_STALE_THRESHOLD_SECONDS=600

HERMES_CANARY_DB_HOST=<db-host>
HERMES_CANARY_DB_PORT=<db-port>
HERMES_CANARY_DB_USER=<dedicated-least-privilege-canary-user>
HERMES_CANARY_DB_PASSWORD=<SECRET — supply via governed secret mechanism, never in Git or any build context>
HERMES_CANARY_DB_NAME=tradingSignals
